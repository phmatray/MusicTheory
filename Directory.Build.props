<Project>

  <PropertyGroup>
    <!-- Default TFM for every project in the repo.
         net11.0 only since 2.0 (net9.0 is out of support, net10.0 dropped with the 2.0 break). -->
    <TargetFramework>net11.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- One version for every package, bumped by the release-please PR (see release-please-config.json). -->
    <Version>1.7.0</Version> <!-- x-release-please-version -->

    <!-- Common Package Metadata -->
    <Authors>phmatray</Authors>
    <Company>phmatray</Company>
    <Copyright>Copyright © 2026 phmatray</Copyright>
    <PackageProjectUrl>https://github.com/phmatray/MusicTheory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/phmatray/MusicTheory</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- SourceLink and Deterministic Build -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- SourceLink for all packable projects -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
