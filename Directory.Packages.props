<Project>

  <PropertyGroup>
    <!-- Enable Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <!-- Testing. All suites run on xunit.v3 (4.x, Microsoft.Testing.Platform v2) through the
         native `dotnet test` MTP mode selected in global.json ("test": { "runner": ... }).
         xunit 2.x is deliberately absent: do not reintroduce it. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="DaisyBlazor.Components" Version="0.6.0" />
  </ItemGroup>

</Project>
