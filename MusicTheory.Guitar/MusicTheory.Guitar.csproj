<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- UI-agnostic guitar data (tunings, voicings, diagram geometry). No Blazor, ASP.NET Core or JS. -->
    <PackageId>MusicTheory.Guitar</PackageId>
    <Product>MusicTheory.Guitar</Product>
    <Description>Guitar companion to MusicTheory: tunings, chord voicings and framework-agnostic chord diagram geometry. No UI dependency.</Description>
    <PackageTags>music;theory;guitar;chords;voicings;chord-diagram;tab;music-theory;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.6.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicTheory\MusicTheory.csproj" />
  </ItemGroup>

</Project>
