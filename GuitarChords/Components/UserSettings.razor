@using GuitarChords.Services
@using System.Text.Json
@inject UserPreferencesService PreferencesService
@inject ISnackbar Snackbar

<Modal @bind-Open="IsVisible" CloseButton="true" Class="w-11/12 max-w-4xl">
    <TitleContent>
        <Typography Typo="Typo.h5">
            <Icon Name="@Icons.Material.Filled.Settings" Class="mr-2" />
            Settings
        </Typography>
    </TitleContent>
    <DialogContent>
        <Tabs>
            <Tab Title="Display">
                <Grid Class="p-2">
                    <Item xs="12" md="6">
                        <Select T="string" @bind-Value="_preferences.DefaultView" Label="Default View">
                            <SelectItem Value="@("grid")">Grid View</SelectItem>
                            <SelectItem Value="@("list")">List View</SelectItem>
                        </Select>
                    </Item>
                    <Item xs="12" md="6">
                        <Typography Typo="Typo.body2" Class="mt-4">Diagram Scale: @_preferences.ChordDiagramScale.ToString("F1")x</Typography>
                        <Range Value="_preferences.ChordDiagramScale" ValueChanged="@((double v) => _preferences.ChordDiagramScale = (float)v)"
                               Min="0.5" Max="2.0" Step="0.1" Label="Diagram Scale" />
                    </Item>
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.ShowChordDiagrams" Color="Color.Primary">
                            Show chord diagrams in lists
                        </Switch>
                    </Item>
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.AutoShowFilters" Color="Color.Primary">
                            Auto-expand filters on page load
                        </Switch>
                    </Item>
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.AutoShowProgression" Color="Color.Primary">
                            Auto-show progression builder
                        </Switch>
                    </Item>
                </Grid>
            </Tab>
            
            <Tab Title="Practice">
                <Grid Class="p-2">
                    <Item xs="12" md="6">
                        <Select T="string" @bind-Value="_preferences.DefaultPracticeMode" Label="Default Practice Mode">
                            <SelectItem Value="@("single")">Single Chord</SelectItem>
                            <SelectItem Value="@("sequence")">Chord Sequence</SelectItem>
                            <SelectItem Value="@("random")">Random Chords</SelectItem>
                        </Select>
                    </Item>
                    <Item xs="12" md="6">
                        <NumericField @bind-Value="_preferences.DefaultBpm" 
                                       Label="Default BPM" 
                                       Min="40" Max="200" />
                    </Item>
                    <Item xs="12" md="6">
                        <NumericField @bind-Value="_preferences.DefaultBeatsPerChord" 
                                       Label="Default Beats per Chord" 
                                       Min="1" Max="8" />
                    </Item>
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.PlayMetronomeSound" Color="Color.Primary">
                            Play metronome sound
                        </Switch>
                    </Item>
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.ShowDiagramInPractice" Color="Color.Primary">
                            Show chord diagram during practice
                        </Switch>
                    </Item>
                </Grid>
            </Tab>
            
            <Tab Title="Chords">
                <Grid Class="p-2">
                    <Item xs="12">
                        <Typography Typo="Typo.subtitle1" Class="mb-2">Show Chord Difficulties</Typography>
                        <div class="flex flex-wrap gap-2">
                            <Chip 
                                   Text="Beginner" 
                                   Color="@(_preferences.ShowBeginnerChords ? Color.Success : Color.Default)"
                                   OnClick="@(() => _preferences.ShowBeginnerChords = !_preferences.ShowBeginnerChords)" />
                            <Chip 
                                   Text="Intermediate" 
                                   Color="@(_preferences.ShowIntermediateChords ? Color.Warning : Color.Default)"
                                   OnClick="@(() => _preferences.ShowIntermediateChords = !_preferences.ShowIntermediateChords)" />
                            <Chip 
                                   Text="Advanced" 
                                   Color="@(_preferences.ShowAdvancedChords ? Color.Error : Color.Default)"
                                   OnClick="@(() => _preferences.ShowAdvancedChords = !_preferences.ShowAdvancedChords)" />
                        </div>
                    </Item>
                    <Item xs="12" md="6">
                        <NumericField @bind-Value="_preferences.MaxRecentChords" 
                                       Label="Max Recent Chords" 
                                       Min="5" Max="20" />
                    </Item>
                </Grid>
            </Tab>
            
            <Tab Title="Progressions">
                <Grid Class="p-2">
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.AutoSuggestNextChord" Color="Color.Primary">
                            Auto-suggest next chords
                        </Switch>
                    </Item>
                    <Item xs="12">
                        <Typography Typo="Typo.body2">Suggestion Confidence Threshold: @_preferences.SuggestionConfidenceThreshold%</Typography>
                        <Range Value="_preferences.SuggestionConfidenceThreshold" ValueChanged="@((double v) => _preferences.SuggestionConfidenceThreshold = (int)v)"
                               Min="0" Max="100" Step="10" Label="Suggestion Confidence Threshold" />
                    </Item>
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.ShowTransitionDifficulty" Color="Color.Primary">
                            Show transition difficulty
                        </Switch>
                    </Item>
                </Grid>
            </Tab>
            
            <Tab Title="Export">
                <Grid Class="p-2">
                    <Item xs="12" md="6">
                        <Select T="string" @bind-Value="_preferences.DefaultExportFormat" Label="Default Export Format">
                            <SelectItem Value="@("text")">Plain Text</SelectItem>
                            <SelectItem Value="@("chordpro")">ChordPro</SelectItem>
                            <SelectItem Value="@("pdf")">PDF</SelectItem>
                        </Select>
                    </Item>
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.IncludeChordDiagramsInPdf" Color="Color.Primary">
                            Include chord diagrams in PDF export
                        </Switch>
                    </Item>
                </Grid>
            </Tab>
            
            <Tab Title="Accessibility">
                <Grid Class="p-2">
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.HighContrastMode" Color="Color.Primary">
                            High contrast mode
                        </Switch>
                    </Item>
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.ReducedMotion" Color="Color.Primary">
                            Reduce animations
                        </Switch>
                    </Item>
                    <Item xs="12">
                        <Switch @bind-Value="_preferences.DarkMode" Color="Color.Primary">
                            Dark mode
                        </Switch>
                    </Item>
                </Grid>
            </Tab>
        </Tabs>
    </DialogContent>
    <DialogActions>
        <Button Color="Color.Secondary" OnClick="ResetToDefaults">Reset to Defaults</Button>
        <Spacer />
        <Button Color="Color.Default" OnClick="Cancel">Cancel</Button>
        <Button Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveSettings">Save Settings</Button>
    </DialogActions>
</Modal>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    
    private UserPreferences _preferences = new();
    private UserPreferences _originalPreferences = new();
    
    
    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && _originalPreferences.DefaultView == "grid") // Check if we need to load
        {
            _preferences = await PreferencesService.GetPreferencesAsync();
            _originalPreferences = JsonSerializer.Deserialize<UserPreferences>(JsonSerializer.Serialize(_preferences))!;
        }
    }
    
    private async Task SaveSettings()
    {
        await PreferencesService.SavePreferencesAsync(_preferences);
        Snackbar.Add("Settings saved successfully", Severity.Success);
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }
    
    private void Cancel()
    {
        _preferences = JsonSerializer.Deserialize<UserPreferences>(JsonSerializer.Serialize(_originalPreferences))!;
        IsVisible = false;
        IsVisibleChanged.InvokeAsync(false);
    }
    
    private async Task ResetToDefaults()
    {
        var result = await ShowConfirmDialog();
        if (result)
        {
            _preferences = new UserPreferences();
            await PreferencesService.ResetPreferencesAsync();
            Snackbar.Add("Settings reset to defaults", Severity.Info);
        }
    }
    
    private async Task<bool> ShowConfirmDialog()
    {
        // In a real app, show a confirmation dialog
        return await Task.FromResult(true);
    }
}