@inherits LayoutComponentBase

<ThemeProvider>
    <div class="min-h-screen flex flex-col bg-base-200">
        <Navbar Shadow="true" Class="sticky top-0 z-30">
            <Start>
                <IconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" Title="Toggle navigation" />
                <Typography Typo="Typo.h5" Class="ml-3">Guitar Chords Dictionary</Typography>
            </Start>
            <End>
                <IconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" Edge="Edge.End" OnClick="ShowSettings" Title="Settings" />
            </End>
        </Navbar>
        <Drawer @bind-Open="_drawerOpen" Class="flex-1">
            <SideContent>
                <aside class="bg-base-100 min-h-full w-64 shadow">
                    <Typography Typo="Typo.h6" Class="px-4 pt-4">Navigation</Typography>
                    <ul class="menu w-full">
                        <NavMenuLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</NavMenuLink>
                        <NavMenuLink Href="/chords" Icon="@Icons.Material.Filled.MusicNote">Explore Chords</NavMenuLink>
                        <NavMenuLink Href="/progressions" Icon="@Icons.Material.Filled.Queue">Chord Progressions</NavMenuLink>
                        <NavMenuLink Href="/tunings" Icon="@Icons.Material.Filled.Tune">Guitar Tunings</NavMenuLink>
                        <NavMenuLink Href="/audio-test" Icon="@Icons.Material.Filled.VolumeUp">Audio Test</NavMenuLink>
                    </ul>
                </aside>
            </SideContent>
            <ChildContent>
                <Container MaxWidth="MaxWidth.Large" Class="my-4 pt-4">
                    @Body
                </Container>
            </ChildContent>
        </Drawer>
    </div>

    <DialogProvider />
    <SnackbarProvider />
    <UserSettings @bind-IsVisible="_showSettings" />
</ThemeProvider>

@code {
    private bool _drawerOpen = true;
    private bool _showSettings;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ShowSettings()
    {
        _showSettings = true;
    }
}
