@using GuitarChords.Models

@if (Chord != null)
{
    <Modal @bind-Open="IsVisible" CloseButton="true" Class="w-11/12 max-w-4xl">
        <TitleContent>
            <Typography Typo="Typo.h5">
                @Chord.Name
                <IconButton Icon="@(IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Filled.FavoriteBorder)" 
                             Color="@(IsFavorite ? Color.Error : Color.Default)"
                             Size="Size.Small"
                             OnClick="@(() => OnToggleFavorite.InvokeAsync(Chord))" />
            </Typography>
        </TitleContent>
        <DialogContent>
            <Tabs>
                <Tab Title="Diagram">
                    <div class="flex justify-center">
                        <ChordDiagram Chord="Chord" Width="300" Height="350" />
                    </div>
                </Tab>
                <Tab Title="Details">
                    <Grid>
                        <Item xs="12">
                            <List>
                                <ListItem Icon="@Icons.Material.Filled.MusicNote">
                                    <div class="flex justify-between">
                                        <Typography>Root Note:</Typography>
                                        <Typography>@Chord.Chord.Root</Typography>
                                    </div>
                                </ListItem>
                                <ListItem Icon="@Icons.Material.Filled.Category">
                                    <div class="flex justify-between">
                                        <Typography>Type:</Typography>
                                        <Typography>@Chord.Chord.Type</Typography>
                                    </div>
                                </ListItem>
                                <ListItem Icon="@Icons.Material.Filled.QueueMusic">
                                    <div class="flex justify-between">
                                        <Typography>Notes:</Typography>
                                        <Typography>@string.Join(" - ", Chord.Chord.GetNotes().Select(n => n.ToString()))</Typography>
                                    </div>
                                </ListItem>
                                <ListItem Icon="@Icons.Material.Filled.Straighten">
                                    <div class="flex justify-between">
                                        <Typography>Barre:</Typography>
                                        <Typography>@(Chord.IsBarreChord ? "Yes" : "No")</Typography>
                                    </div>
                                </ListItem>
                                <ListItem Icon="@Icons.Material.Filled.SignalCellularAlt">
                                    <div class="flex justify-between">
                                        <Typography>Difficulty:</Typography>
                                        <Chip Text="@Difficulty" Size="Size.Small" Color="@DifficultyColor" />
                                    </div>
                                </ListItem>
                            </List>
                        </Item>
                    </Grid>
                </Tab>
                <Tab Title="Fingering">
                    <SimpleTable Dense="true" Hover="true" Bordered="true">
                        <thead>
                            <tr>
                                <th>String</th>
                                <th>Note</th>
                                <th>Fret</th>
                                <th>Finger</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 6; i++)
                            {
                                var stringIndex = 5 - i;
                                var fret = Chord.FretPositions[stringIndex];
                                var finger = Chord.Fingerings[stringIndex];
                                var openNote = GuitarTuning.StandardTuning[stringIndex];
                                
                                <tr>
                                    <td>@(i + 1) (@openNote.Name@(openNote.Octave))</td>
                                    <td>
                                        @if (fret == -1) { <Chip Text="Muted" Size="Size.Small" Color="Color.Error" /> }
                                        else if (fret == 0) { <text>@openNote</text> }
                                        else { <text>@GuitarTuning.GetNoteAtFret(stringIndex, fret)</text> }
                                    </td>
                                    <td>
                                        @if (fret >= 0) { <text>@fret</text> }
                                        else { <text>-</text> }
                                    </td>
                                    <td>
                                        @if (finger > 0) { <Avatar Size="Size.Small" Color="Color.Primary">@finger</Avatar> }
                                        else if (fret == 0) { <Chip Text="Open" Size="Size.Small" Color="Color.Success" /> }
                                        else { <text>-</text> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </SimpleTable>
                </Tab>
            </Tabs>
        </DialogContent>
        <DialogActions>
            @if (ShowProgressionButton)
            {
                <Button Color="Color.Primary" Variant="Variant.Text" OnClick="@(() => OnAddToProgression.InvokeAsync(Chord))">
                    Add to Progression
                </Button>
            }
            <Button Color="Color.Default" OnClick="@(() => IsVisible = false)">Close</Button>
        </DialogActions>
    </Modal>
}

@code {
    [Parameter] public GuitarChord? Chord { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public bool ShowProgressionButton { get; set; }
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter] public string Difficulty { get; set; } = "Beginner";
    [Parameter] public Color DifficultyColor { get; set; } = Color.Success;
    [Parameter] public EventCallback<GuitarChord> OnAddToProgression { get; set; }
    [Parameter] public EventCallback<GuitarChord> OnToggleFavorite { get; set; }


    protected override void OnParametersSet()
    {
        if (IsVisible != (Chord != null))
        {
            IsVisibleChanged.InvokeAsync(IsVisible);
        }
    }
}