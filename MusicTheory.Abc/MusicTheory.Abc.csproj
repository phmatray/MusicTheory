<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ABC notation: single-voice tunes. -->
    <PackageId>MusicTheory.Abc</PackageId>
    <Product>MusicTheory.Abc</Product>
    <Description>ABC notation for MusicTheory: reads single-voice ABC tunes into spelled notes, durations and measures.</Description>
    <PackageTags>music;theory;abc;abc-notation;folk;tunes;music-theory;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- No baseline: the package has not been published yet. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicTheory\MusicTheory.csproj" />
  </ItemGroup>

</Project>
