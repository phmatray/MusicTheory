@using MusicTheory.Guitar.Blazor
@implements IDisposable
@inject ChordAudio Audio

<button type="button" class="tb-btn tb-play" @onclick="PlayAsync">@Strings.T(Lang, _played ? "intervals.replay" : "intervals.play")</button>

@code {
    /// <summary>Spacing of the two notes of a melodic interval, in ms (ChordAudio's strum is the gap).</summary>
    private const int MelodicGapMs = 700;
    private const int ChordStepMs = 1100;

    [Parameter, EditorRequired] public IReadOnlyList<IReadOnlyList<Note>> Sounds { get; set; } = default!;
    [Parameter, EditorRequired] public Lang Lang { get; set; }

    /// <summary>Spacing of the notes of a melodic question, in ms (a scale plays faster than an interval).</summary>
    [Parameter] public int GapMs { get; set; } = MelodicGapMs;

    /// <summary>True when each step is a chord of its own (a progression), not a note of a melody.</summary>
    [Parameter] public bool ChordSteps { get; set; }

    private bool _played;
    private CancellationTokenSource? _cts;

    // Leaving the question stops the rest of a progression, so it cannot sound over the next one.
    public void Dispose() => _cts?.Cancel();

    // Behind a click: browsers refuse audio before a user gesture.
    private async Task PlayAsync()
    {
        var steps = DrillAudio.ToSchedule(Sounds);
        _played = true;
        if (ChordSteps)
        {
            _cts?.Cancel();
            _cts = new CancellationTokenSource();
            var token = _cts.Token;
            for (var i = 0; i < steps.Count && !token.IsCancellationRequested; i++)
            {
                await Audio.PlayAsync(steps[i]);
                if (i < steps.Count - 1) await Task.Delay(ChordStepMs, token).ContinueWith(_ => { });
            }
        }
        else if (steps.Count == 1)
            await Audio.PlayAsync(steps[0], strumMs: 0);
        else
            await Audio.PlayAsync(steps.SelectMany(s => s).ToArray(), strumMs: GapMs);
    }
}
