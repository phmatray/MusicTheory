<PageTitle>@Strings.T(State.Lang, "shell.title")</PageTitle>

<h1>@Strings.T(State.Lang, "shell.title")</h1>
<p>@Strings.T(State.Lang, "shell.intro")</p>
<ul class="tb-grid">
    @foreach (var tool in ToolRegistry.All)
    {
        <li><a href="@ToolboxUrl.Build(new ToolState(tool.Id, State.Lang, new Dictionary<string, string>()))">@Strings.T(State.Lang, tool.TitleKey)</a></li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public ToolState State { get; set; } = default!;
}
